# HTTP
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# SQLite file. The directory is created on startup.
DATABASE_PATH=./data/inbox.sqlite

# Required before a note, link, or question can be saved or answered.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional overrides.
EMBEDDING_MODEL=text-embedding-3-small
ANSWER_MODEL=gpt-4o-mini

# Closest chunks kept for an answer, and the lowest cosine score accepted.
TOP_K=5
MIN_SCORE=0.22
